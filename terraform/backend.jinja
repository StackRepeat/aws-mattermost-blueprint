## Generated by the platform runtime. Do not add concrete backend values here. ##

{% if tf_distribution_type == "oss" -%}
terraform {
  backend "s3" {
    region         = "{{ region }}"
    bucket         = "{{ bucket }}"
    key            = "{{ key }}"
    dynamodb_table = "{{ dynamodb_table }}"
    encrypt        = true
    kms_key_id     = "{{ kms_key_id }}"
    role_arn       = "{{ stack_repeat_admin_role_arn }}"
  }
}
{% else -%}
terraform {
  backend "remote" {
    organization = "{{ terraform_org_name }}"
    workspaces {
      name = "{{ terraform_workspace_name }}"
    }
  }
}
{% endif %}
